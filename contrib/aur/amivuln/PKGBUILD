pkgname=amivuln
pkgver=0.2.0
pkgrel=1
pkgdesc='Am I vulnerable? Backport-aware CVE check for binaries, services and packages on this host'
arch=('x86_64' 'aarch64')
url='https://github.com/nubian-ibex/amivuln'
license=('MIT' 'Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/source.tar.gz")
sha256sums=('94cadeca2ae37a14a4e1d48b6d4594c34b433da78ce0a34298917be0dc9e4c9b')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p amivuln
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p amivuln-version -p amivuln-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/amivuln "$pkgdir/usr/bin/amivuln"
  install -Dm644 contrib/completions/amivuln.bash "$pkgdir/usr/share/bash-completion/completions/amivuln"
  install -Dm644 contrib/completions/_amivuln "$pkgdir/usr/share/zsh/site-functions/_amivuln"
  install -Dm644 contrib/completions/amivuln.fish "$pkgdir/usr/share/fish/vendor_completions.d/amivuln.fish"
  install -Dm644 contrib/man/*.1 -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
