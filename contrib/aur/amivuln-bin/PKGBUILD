pkgname=amivuln-bin
_name=amivuln
pkgver=0.0.10
pkgrel=1
pkgdesc='Am I vulnerable? Backport-aware CVE check (static release binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/nubian-ibex/amivuln'
license=('MIT' 'Apache-2.0')
provides=('amivuln')
conflicts=('amivuln')
options=('!strip')
source_x86_64=("$_name-$pkgver-x86_64.tar.zst::$url/releases/download/v$pkgver/amivuln-x86_64-unknown-linux-musl.tar.zst")
source_aarch64=("$_name-$pkgver-aarch64.tar.zst::$url/releases/download/v$pkgver/amivuln-aarch64-unknown-linux-musl.tar.zst")
sha256sums_x86_64=('222bf5fd4eea4c6c3c79611e1b961f09de5abc18ce2a5988ef41b49171aa2919')
sha256sums_aarch64=('15ac39760e4853847033dcd48f49bc45ef94f558d27f3edf063ae5d729b1a537')
noextract=("$_name-$pkgver-x86_64.tar.zst" "$_name-$pkgver-aarch64.tar.zst")

# Provenance can be checked before installing:
#   gh attestation verify amivuln-$pkgver-<arch>.tar.zst --repo nubian-ibex/amivuln

package() {
  local dir="amivuln-$CARCH-unknown-linux-musl"
  bsdtar -xf "$_name-$pkgver-$CARCH.tar.zst"
  install -Dm755 "$dir/amivuln" "$pkgdir/usr/bin/amivuln"
  install -Dm644 "$dir/completions/amivuln.bash" "$pkgdir/usr/share/bash-completion/completions/amivuln"
  install -Dm644 "$dir/completions/_amivuln" "$pkgdir/usr/share/zsh/site-functions/_amivuln"
  install -Dm644 "$dir/completions/amivuln.fish" "$pkgdir/usr/share/fish/vendor_completions.d/amivuln.fish"
  install -Dm644 "$dir"/man/*.1 -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 "$dir/LICENSE-MIT" "$dir/LICENSE-APACHE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
