{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Subset of SARIF 2.1.0 that amivuln relies on",
  "type": "object",
  "required": ["version", "runs"],
  "properties": {
    "version": { "const": "2.1.0" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool"],
        "properties": {
          "tool": {
            "type": "object",
            "required": ["driver"],
            "properties": {
              "driver": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "version": { "type": "string" },
                  "informationUri": { "type": "string", "format": "uri" }
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["message"],
              "properties": {
                "ruleId": { "type": "string", "minLength": 1 },
                "level": { "enum": ["none", "note", "warning", "error"] },
                "message": {
                  "type": "object",
                  "required": ["text"],
                  "properties": { "text": { "type": "string", "minLength": 1 } }
                },
                "properties": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
